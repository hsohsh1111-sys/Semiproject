# Copy to deploy/ec2/.env and fill secrets on EC2. Do not commit the filled file.
APP_ENV=
FRONTEND_ORIGINS=
SECRET_KEY=
TIDB_HOST=
TIDB_USERNAME=
TIDB_PASSWORD=
TIDB_DATABASE=
OPENAI_API_KEY=

# Optional: use DATABASE_URL instead of the TIDB_* connection fields.
# DATABASE_URL=
# Optional mail settings, only if signup email delivery is needed.
# EMAIL_PROVIDER=
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
