# Copy to /srv/onfit/.env on EC2 and fill in production values.
APP_ENV=production
FRONTEND_ORIGINS=https://your-domain.example

# Use DATABASE_URL or all TIDB_* values. URL passwords must be percent-encoded.
DATABASE_URL=
TIDB_HOST=
TIDB_PORT=4000
TIDB_USERNAME=
TIDB_PASSWORD=
TIDB_DATABASE=

# Generate with: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional email verification settings.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Optional AI integration.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
OPENAI_TRYON_MODEL=
