FROM node:22-bookworm-slim AS build

WORKDIR /workspace

COPY frontend/package.json frontend/package-lock.json ./frontend/
COPY ai-fashion/package.json ai-fashion/package-lock.json ./ai-fashion/
RUN npm ci --prefix frontend \
    && npm ci --prefix ai-fashion

COPY frontend/ ./frontend/
COPY ai-fashion/ ./ai-fashion/
COPY scripts/build-site.mjs ./scripts/build-site.mjs
RUN npm run build:site --prefix frontend

FROM nginx:alpine
COPY deploy/ec2/nginx.container.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/frontend/dist/ /usr/share/nginx/html/

EXPOSE 80
