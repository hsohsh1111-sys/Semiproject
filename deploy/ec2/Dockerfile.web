FROM node:22-bookworm-slim AS build
WORKDIR /src

COPY frontend/package.json frontend/package-lock.json ./frontend/
COPY ai-fashion/package.json ai-fashion/package-lock.json ./ai-fashion/
RUN npm --prefix frontend ci --no-audit --no-fund \
    && npm --prefix ai-fashion ci --no-audit --no-fund

COPY frontend/ ./frontend/
COPY ai-fashion/ ./ai-fashion/
COPY scripts/build-site.mjs ./scripts/build-site.mjs

ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} VITE_API_URL=
RUN npm --prefix frontend run build:site

FROM nginx:stable-alpine
COPY deploy/ec2/nginx.onfit.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/frontend/dist/ /usr/share/nginx/html/
EXPOSE 80
