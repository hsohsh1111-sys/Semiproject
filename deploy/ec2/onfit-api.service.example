# Example only. Requires an existing onfit user and /srv/onfit checkout.
# Install dependencies in the Linux venv before enabling this service.
[Unit]
Description=ONFIT FastAPI
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=onfit
Group=onfit
WorkingDirectory=/srv/onfit/backend
EnvironmentFile=/etc/onfit/backend.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/onfit/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
