# TiDB Cloud MySQL compatible connection
DATABASE_URL=mysql+pymysql://USER:PASSWORD@GATEWAY_HOST:4000/onfit3?ssl_verify_cert=true&ssl_verify_identity=true
TIDB_HOST=
TIDB_PORT=4000
TIDB_USERNAME=
TIDB_PASSWORD=
TIDB_DATABASE=onfit3

# API
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5173
SECRET_KEY=replace-with-a-long-random-value

# Optional collection / marketplace integrations
COLLECTION_INTERVAL_HOURS=12
SHOPPING_PARTNER_API_KEY=

# CircleToSearch (server-side only)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-luna
MUSINSA_VISION_CATEGORY_GUIDE=false
OPENAI_TRYON_MODEL=gpt-image-2.5-flare
OPENAI_TRYON_QUALITY=medium
OPENAI_TRYON_SIZE=

