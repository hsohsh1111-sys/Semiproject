# TiDB Cloud MySQL compatible connection
DATABASE_URL=mysql+pymysql://USER:PASSWORD@GATEWAY_HOST:4000/onfit?ssl_verify_cert=true&ssl_verify_identity=true

# API
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5173
SECRET_KEY=replace-with-a-long-random-value

# Optional collection / marketplace integrations
COLLECTION_INTERVAL_HOURS=12
SHOPPING_PARTNER_API_KEY=
