# Copy only the settings you need into backend/.env. Never commit real secrets.
# Use DATABASE_URL OR all five TIDB_* values. URL passwords must be percent-encoded.
DATABASE_URL=
TIDB_HOST=
TIDB_PORT=4000
TIDB_USERNAME=
TIDB_PASSWORD=
TIDB_DATABASE=

APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set a new random secret of at least 32 bytes in the actual environment.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Separate admin login. Password HASH only; no actual email or DB account needed.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Render Free blocks SMTP ports: use an HTTPS mail provider there.
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Email verification: SSL on 465, otherwise STARTTLS (usually 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false

# Optional local OCR paths. Leave empty on the Docker deployment.
TESSERACT_CMD=
TESSERACT_DATA_DIR=

COLLECTION_INTERVAL_HOURS=12
SHOPPING_PARTNER_API_KEY=

# Frontend build-time settings: API URL only; NEVER put secrets in VITE_*.
VITE_API_BASE_URL=
VITE_API_URL=

# Optional paid integration; leave unconfigured unless explicitly needed.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
MUSINSA_VISION_CATEGORY_GUIDE=true
OPENAI_TRYON_MODEL=
